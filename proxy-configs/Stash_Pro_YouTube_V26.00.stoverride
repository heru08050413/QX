name: "[实验性·未验证] Stash Pro YouTube 增强"
desc: "【实验性·未经真机验证·默认不建议启用】去广告/PiP/隐藏上传按钮。状态说明：主 README 第三节将 Stash 的 YouTube 去广告标注为 ❌，理由是 Maasea 方案依赖 protobuf 二进制改写，而 Stash 脚本层的该能力尚未在真机证实；本文件是针对 Stash 原生 binary-mode 的适配尝试，脚本本身与 Shadowrocket/Loon 侧同源并锁定 commit 65075cd，但从未在 iPhone 上验证过去广告、PiP 或隐藏上传按钮实际生效。另含第三方 Worker(init-stream.maasea.workers.dev)转发依赖，上游作者只保证 Surge。启用前务必阅读 Stash_Pro_README.md 的风险说明；若播放卡顿或异常，单独关闭本覆写即可，主分流不受影响。"
# 适配 Stash 原生 binary-mode / require-body / Uint8Array / $done(response)。
# 不可同时启用其他 YouTube 重写。未擅自生成证书或关闭服务器证书校验。
http:
  mitm:
    - youtubei.googleapis.com
    - '*.googlevideo.com'
  script:
    - name: yt-response
      match: '^https:\/\/youtubei\.googleapis\.com\/(youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config))(\?(.*))?$'
      type: response
      require-body: true
      binary-mode: true
      max-size: 5242880
      timeout: 10
      argument: '{"captionLang":"off","blockUpload":true,"blockImmersive":true,"blockShorts":false,"debug":false}'
    - name: yt-request
      match: '^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.*'
      type: request
      require-body: true
      binary-mode: true
      max-size: 5242880
      timeout: 10
      argument: '{"captionLang":"off"}'
    - name: yt-request
      match: '^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event'
      type: request
      require-body: true
      binary-mode: true
      max-size: 5242880
      timeout: 10
script-providers:
  yt-response:
    url: https://raw.githubusercontent.com/Maasea/sgmodule/65075cdb388fc5e3094afd7e7314c67b243f3525/Script/Youtube/youtube.response.js
    interval: 86400
  yt-request:
    url: https://raw.githubusercontent.com/Maasea/sgmodule/65075cdb388fc5e3094afd7e7314c67b243f3525/Script/Youtube/youtube.request.js
    interval: 86400
