rules: #!replace
  # 1. 局域网、本地 DNS 与 Tailscale 家庭组网直连（所有 IP 规则均加 no-resolve）
  - DOMAIN,dns.alidns.com,DIRECT
  - DOMAIN,doh.pub,DIRECT
  - DOMAIN-SUFFIX,lan,DIRECT
  - DOMAIN-SUFFIX,local,DIRECT
  - DOMAIN-SUFFIX,localhost,DIRECT
  - DOMAIN-SUFFIX,home.arpa,DIRECT
  - DOMAIN-SUFFIX,ts.net,DIRECT
  - DOMAIN-SUFFIX,tailscale.com,DIRECT
  - DOMAIN-SUFFIX,tailscale.io,DIRECT
  - RULE-SET,PrivateDomains,DIRECT
  - IP-CIDR,0.0.0.0/8,DIRECT,no-resolve
  - IP-CIDR,10.0.0.0/8,DIRECT,no-resolve
  - IP-CIDR,100.64.0.0/10,DIRECT,no-resolve
  - IP-CIDR,127.0.0.0/8,DIRECT,no-resolve
  - IP-CIDR,169.254.0.0/16,DIRECT,no-resolve
  - IP-CIDR,172.16.0.0/12,DIRECT,no-resolve
  - IP-CIDR,192.168.0.0/16,DIRECT,no-resolve
  - IP-CIDR,224.0.0.0/4,DIRECT,no-resolve
  - IP-CIDR6,::1/128,DIRECT,no-resolve
  - IP-CIDR6,fc00::/7,DIRECT,no-resolve
  - IP-CIDR6,fd7a:115c:a1e0::/48,DIRECT,no-resolve
  - IP-CIDR6,fe80::/10,DIRECT,no-resolve

  # 2. MITM 域的应用层 UDP 443(QUIC) 回落 TCP（必须排在下方 DIRECT 保护区之前）
  #    仅拦截对应 API 域名的 UDP 443 防止绕过 MITM，不影响全局 UDP 与 HY2/TUIC 节点隧道。
  - AND,((DOMAIN-SUFFIX,googlevideo.com),(NETWORK,udp),(DST-PORT,443)),REJECT
  - AND,((DOMAIN-SUFFIX,youtube.com),(NETWORK,udp),(DST-PORT,443)),REJECT
  - AND,((DOMAIN,youtubei.googleapis.com),(NETWORK,udp),(DST-PORT,443)),REJECT
  - AND,((DOMAIN,youtubei-att.googleapis.com),(NETWORK,udp),(DST-PORT,443)),REJECT
  - AND,((DOMAIN-SUFFIX,ytimg.com),(NETWORK,udp),(DST-PORT,443)),REJECT
  - AND,((DOMAIN-SUFFIX,ggpht.com),(NETWORK,udp),(DST-PORT,443)),REJECT
  - AND,((DOMAIN,api.weibo.cn),(NETWORK,udp),(DST-PORT,443)),REJECT
  - AND,((DOMAIN,sub.weibo.cn),(NETWORK,udp),(DST-PORT,443)),REJECT
  - AND,((DOMAIN,we.weibo.cn),(NETWORK,udp),(DST-PORT,443)),REJECT
  - AND,((DOMAIN,sdkapp.uve.weibo.com),(NETWORK,udp),(DST-PORT,443)),REJECT
  - AND,((DOMAIN,wbapp.uve.weibo.com),(NETWORK,udp),(DST-PORT,443)),REJECT
  - AND,((DOMAIN,sdkapp.mob.uve.weibo.com),(NETWORK,udp),(DST-PORT,443)),REJECT
  - AND,((DOMAIN,wbapp.mob.uve.weibo.com),(NETWORK,udp),(DST-PORT,443)),REJECT
  - AND,((DOMAIN,api.zhihu.com),(NETWORK,udp),(DST-PORT,443)),REJECT
  - AND,((DOMAIN,www.zhihu.com),(NETWORK,udp),(DST-PORT,443)),REJECT
  - AND,((DOMAIN,zhuanlan.zhihu.com),(NETWORK,udp),(DST-PORT,443)),REJECT
  - AND,((DOMAIN,edith.xiaohongshu.com),(NETWORK,udp),(DST-PORT,443)),REJECT
  - AND,((DOMAIN,www.xiaohongshu.com),(NETWORK,udp),(DST-PORT,443)),REJECT
  - AND,((DOMAIN,acs.m.taobao.com),(NETWORK,udp),(DST-PORT,443)),REJECT
  - AND,((DOMAIN,guide-acs.m.taobao.com),(NETWORK,udp),(DST-PORT,443)),REJECT
  - AND,((DOMAIN,acs.m.goofish.com),(NETWORK,udp),(DST-PORT,443)),REJECT
  - AND,((DOMAIN,api.m.jd.com),(NETWORK,udp),(DST-PORT,443)),REJECT
  - AND,((DOMAIN,m5.amap.com),(NETWORK,udp),(DST-PORT,443)),REJECT
  - AND,((DOMAIN,amap-aos-info-nogw.amap.com),(NETWORK,udp),(DST-PORT,443)),REJECT
  - AND,((DOMAIN,api.pinduoduo.com),(NETWORK,udp),(DST-PORT,443)),REJECT
  - AND,((DOMAIN,api.yangkeduo.com),(NETWORK,udp),(DST-PORT,443)),REJECT

  # 3. 国内关键连通性保护区（严格排在 Ads 之前，防止微信/微博/知乎/运营商一键登录转圈）
  - DOMAIN-SUFFIX,weixin.qq.com,DIRECT
  - DOMAIN-SUFFIX,weixin.com,DIRECT
  - DOMAIN-SUFFIX,wx.qq.com,DIRECT
  - DOMAIN-SUFFIX,qq.com.cn,DIRECT
  - DOMAIN,dns.weixin.qq.com,DIRECT
  - DOMAIN,teg.tencent-cloud.net,DIRECT
  - DOMAIN-SUFFIX,wechat.com,DIRECT
  - DOMAIN-SUFFIX,weixinbridge.com,DIRECT
  - DOMAIN-SUFFIX,tenpay.com,DIRECT
  - DOMAIN-SUFFIX,alipay.com,DIRECT
  - DOMAIN,amdc.alipay.com,DIRECT
  - DOMAIN,c-hzgt2.getui.com,DIRECT
  - DOMAIN-SUFFIX,push.apple.com,DIRECT
  - DOMAIN-SUFFIX,cmpassport.com,DIRECT
  - DOMAIN-SUFFIX,id6.me,DIRECT
  - DOMAIN,open.e.189.cn,DIRECT
  - DOMAIN,mdn.open.wo.cn,DIRECT
  - DOMAIN,opencloud.wostore.cn,DIRECT
  - DOMAIN,auth.wosms.cn,DIRECT
  - DOMAIN-SUFFIX,10099.com.cn,DIRECT
  # 精确放行正文与开屏改写域，保留广告子域在下一节被拦截
  - DOMAIN,api.weibo.cn,DIRECT
  - DOMAIN,sub.weibo.cn,DIRECT
  - DOMAIN,we.weibo.cn,DIRECT
  - DOMAIN,sdkapp.uve.weibo.com,DIRECT
  - DOMAIN,wbapp.uve.weibo.com,DIRECT
  - DOMAIN,sdkapp.mob.uve.weibo.com,DIRECT
  - DOMAIN,wbapp.mob.uve.weibo.com,DIRECT
  - DOMAIN,api.zhihu.com,DIRECT
  - DOMAIN,www.zhihu.com,DIRECT
  - DOMAIN,zhuanlan.zhihu.com,DIRECT
  - DOMAIN,zhstatic.zhihu.com,DIRECT
  - DOMAIN,appcloud2.zhihu.com,DIRECT
  - DOMAIN,link.zhihu.com,DIRECT
  - DOMAIN,edith.xiaohongshu.com,DIRECT
  - DOMAIN,www.xiaohongshu.com,DIRECT
  - DOMAIN,ci.xiaohongshu.com,DIRECT
  - DOMAIN-SUFFIX,browser-intake-datadoghq.com,AI

  # 4. 高频遥测熔断（REJECT-DROP 静默丢包防死循环耗电）+ 0-MITM 精准 App 广告 + 全局广告集
  - DOMAIN,umc.danuoyi.alicdn.com,REJECT-DROP
  - DOMAIN,Aisou.ialicdn.com,REJECT-DROP
  - DOMAIN-SUFFIX,mum.alibabachengdun.com,REJECT-DROP
