  script:
    # ---- 1. 国内 App 开屏与信息流净化（内嵌 payload，零外部脚本下载）----
    - name: stash-pro-ads
      match: '^https?:\/\/(?:sdk|wb)app\.(?:mob\.)?uve\.weibo\.com\/(?:interface\/sdk\/sdkad\.php|wbapplua\/wbpullad\.lua)'
      type: response
      require-body: true
      max-size: 2097152
      timeout: 3
    - name: stash-pro-ads
      match: '^https?:\/\/(?:api|sub|we)\.weibo\.cn\/2\/!\/client\/(?:wbpullad|sdkad|splash|launch|openscreen)'
      type: response
      require-body: true
      max-size: 2097152
      timeout: 3
    - name: stash-pro-ads
      match: '^https:\/\/(?:api|sub|we)\.weibo\.cn\/\d+\/(?:groups\/timeline|statuses\/(?:unread|friends\/timeline|friends_timeline|video_timeline|container_timeline(?:_hot|_unread)?)|search\/container_timeline)(?:\?|$)'
      type: response
      require-body: true
      max-size: 2097152
      timeout: 3
    - name: stash-pro-ads
      match: '^https:\/\/api\.zhihu\.com\/(?:topstory\/(?:recommend|hot-lists\/total)|next-bff|next-data|next-render)(?:\?|$|\/)'
      type: response
      require-body: true
      max-size: 2097152
      timeout: 3
    - name: stash-pro-ads
      match: '^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v[12]\/(?:homefeed|search\/notes|system_service\/splash_config)(?:\?|$)'
      type: response
      require-body: true
      max-size: 2097152
      timeout: 3
    - name: stash-pro-ads
      match: '^https?:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.taobao\.(?:cloudvideo\.video\.query|wireless\.home\.splash\.awesome\.get)'
      type: response
      require-body: true
      max-size: 2097152
      timeout: 3
    - name: stash-pro-ads
      match: '^https?:\/\/poplayer\.template\.alibaba\.com\/\w+\.json'
      type: response
      require-body: true
      max-size: 2097152
      timeout: 3
    - name: stash-pro-ads
      match: '^https?:\/\/api\.m\.jd\.com\/client\.action\?functionId=start(?:&|$)'
      type: response
      require-body: true
      max-size: 2097152
      timeout: 3

    # ---- 2. YouTube 去广告 / 画中画 / 隐藏上传按钮（Maasea 锁定提交；实验性，含第三方 Worker 转发依赖）----
    # 若真机播放异常，可临时注释下面 3 条 yt-* hook 与上方 YouTube 2 个 mitm 域排查，不影响主分流与开屏去广告。
    - name: yt-response
      match: '^https:\/\/youtubei\.googleapis\.com\/(youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config))(\?(.*))?$'
      type: response
      require-body: true
      binary-mode: true
      max-size: 5242880
      timeout: 10
      argument: '{"captionLang":"off","blockUpload":true,"blockImmersive":true,"blockShorts":false,"debug":false}'
    - name: yt-request
      match: '^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.*'
      type: request
      require-body: true
      binary-mode: true
      max-size: 5242880
      timeout: 10
      argument: '{"captionLang":"off"}'
    - name: yt-request
      match: '^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event'
      type: request
      require-body: true
      binary-mode: true
      max-size: 5242880
      timeout: 10

script-providers:
  stash-pro-ads:
    # 内嵌轻量脚本：零外部下载、不读取订阅/Cookie/存储、不发外部请求；未知或异常包原样放行。
    payload: |
      (() => {
        let result = {};
        try {
          if ($response.status !== 200 || typeof $response.body !== "string" || !$response.body) {
            $done(result); return;
          }
          const url = $request.url;
          const body = $response.body;
          let changed = false;
          const yes = value => value === true || value === 1 || value === "1";
          const filter = (parent, key, isAd) => {
            if (!parent || !Array.isArray(parent[key])) return;
            const original = parent[key];
            const clean = original.filter(item => !isAd(item));
            if (clean.length !== original.length) { parent[key] = clean; changed = true; }
          };

          if (/\/interface\/sdk\/sdkad\.php/.test(url)) {
            const match = body.match(/\{[\s\S]*\}/);
            if (!match) { $done(result); return; }
            const obj = JSON.parse(match[0]);
            if (!obj || typeof obj !== "object" || Array.isArray(obj)) { $done(result); return; }
            if (Array.isArray(obj.ads) && obj.ads.length) { obj.ads = []; changed = true; }
            if (obj.background_delay_display_time && obj.background_delay_display_time !== 86400000) {
              obj.background_delay_display_time = 86400000; changed = true;
            }
            if (obj.show_push_splash_ad) { obj.show_push_splash_ad = false; changed = true; }
            if (changed) {
              const tail = body.slice(match.index + match[0].length);
              result = {body: JSON.stringify(obj) + tail};
            }
            $done(result); return;
          }

          const obj = JSON.parse(body);
          if (!obj || typeof obj !== "object" || Array.isArray(obj)) { $done(result); return; }

          if (/\/wbapplua\/wbpullad\.lua|\/2\/!\/client\/(?:wbpullad|sdkad|splash|launch|openscreen)/.test(url)) {
            if (Array.isArray(obj.cached_ad?.ads) && obj.cached_ad.ads.length) {
              obj.cached_ad.ads = []; changed = true;
            }
            if (Array.isArray(obj.ads) && obj.ads.length) { obj.ads = []; changed = true; }
            if (obj.show_push_splash_ad) { obj.show_push_splash_ad = false; changed = true; }
          } else if (/^https:\/\/(?:api|sub|we)\.weibo\.cn\//.test(url)) {
            const weiboAd = item => !!item && (
              yes(item.mblogtype) || yes(item.ad_state) || item.promotion?.type === "ad"
            );
            filter(obj, "statuses", weiboAd);
            filter(obj, "items", item => item?.category === "feed" && weiboAd(item.data));
            for (const key of ["advertises", "ad"]) {
              if (Array.isArray(obj[key]) && obj[key].length) { obj[key] = []; changed = true; }
            }
          } else if (/^https:\/\/api\.zhihu\.com\//.test(url)) {
            const zhihuAd = item => !!item && (
              ["feed_advert", "ad", "advert"].includes(item.type) ||
              ["feed_advert", "ad", "advert"].includes(item.origin_data?.type) ||
              ["ad", "advert"].includes(item.origin_data?.resource_type) ||
              item.common_card?.footline?.elements?.some?.(e => e?.text?.panel_text === "广告") === true
            );
            filter(obj, "data", zhihuAd);
            filter(obj.data, "data", zhihuAd);
          } else if (/^https:\/\/edith\.xiaohongshu\.com\//.test(url)) {
            if (/\/system_service\/splash_config(?:\?|$)/.test(url)) {
              if (Array.isArray(obj.data?.ads_groups) && obj.data.ads_groups.length) {
                obj.data.ads_groups = []; changed = true;
              }
            } else {
              const xhsAd = item => !!item && (
                ["ad", "ads"].includes(item.model_type) || yes(item.is_ad)
              );
              filter(obj.data, "items", xhsAd);
              filter(obj, "data", xhsAd);
            }
          } else if (/^https?:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.taobao\.cloudvideo\.video\.query/.test(url)) {
            const d = obj.data;
            if (d && typeof d === "object") {
              if (d.duration && d.duration !== "0") { d.duration = "0"; changed = true; }
              if (Array.isArray(d.resources) && d.resources.length) { d.resources = []; changed = true; }
              if (Array.isArray(d.caches) && d.caches.length) { d.caches = []; changed = true; }
              if (d.respTimeInMs && d.respTimeInMs !== "3818332800000") {
                d.respTimeInMs = "3818332800000"; changed = true;
              }
            }
          } else if (/^https?:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.taobao\.wireless\.home\.splash\.awesome\.get/.test(url)) {
            const list = obj.data?.containers?.splash_home_base?.base?.sections;
            if (Array.isArray(list)) {
              for (const sec of list) {
                const items = sec?.bizData?.["taobao-splash"]?.data;
                if (!Array.isArray(items)) continue;
                for (const item of items) {
                  if (!item || typeof item !== "object") continue;
                  item.waitTime = "0"; item.times = "0"; item.hotStart = "false";
                  item.haveVoice = "false"; item.hideTBLogo = "false"; item.enable4G = "false"; item.coldStart = "false";
                  item.startTime = "3818332800000"; item.endTime = "3818419199000";
                  item.gmtStart = "2090-12-31 00:00:00"; item.gmtEnd = "2090-12-31 23:59:59";
                  item.gmtStartMs = "3818332800000"; item.gmtEndMs = "3818419199000";
                  if (item.imgUrl) item.imgUrl = "";
                  if (item.videoUrl) item.videoUrl = "";
                  changed = true;
                }
              }
            }
          } else if (/^https?:\/\/poplayer\.template\.alibaba\.com\/\w+\.json/.test(url)) {
            if (Array.isArray(obj.res?.images) && obj.res.images.length) { obj.res.images = []; changed = true; }
            if (Array.isArray(obj.res?.videos) && obj.res.videos.length) { obj.res.videos = []; changed = true; }
            if (obj.enable) { obj.enable = false; changed = true; }
            if (Array.isArray(obj.mainRes?.images) && obj.mainRes.images.length) { obj.mainRes.images = []; changed = true; }
          } else if (/^https?:\/\/api\.m\.jd\.com\/client\.action\?functionId=start(?:&|$)/.test(url)) {
            if (Array.isArray(obj.images) && obj.images.length) { obj.images = []; changed = true; }
            if (obj.showTimesDaily) { obj.showTimesDaily = 0; changed = true; }
          }

          if (changed) result = {body: JSON.stringify(obj)};
        } catch (_) {
          // HTTP 错误、HTML、未知 JSON 结构一律保留原响应，不输出用户内容。
          result = {};
        }
        $done(result);
      })();
  yt-response:
    url: https://raw.githubusercontent.com/Maasea/sgmodule/65075cdb388fc5e3094afd7e7314c67b243f3525/Script/Youtube/youtube.response.js
    interval: 86400
  yt-request:
    url: https://raw.githubusercontent.com/Maasea/sgmodule/65075cdb388fc5e3094afd7e7314c67b243f3525/Script/Youtube/youtube.request.js
    interval: 86400
