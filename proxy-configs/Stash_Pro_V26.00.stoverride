name: Stash Pro V26.00
desc: Stash 3.4+ 单文件全栈覆写（18 个 MRS 二进制纯索引规则集 + 6 地区共享 lazy 测速池 + 开屏/信息流内嵌去广告 + YouTube 增强）。叠加在机场配置上启用，保留机场节点与 DNS。
# 架构要点（发挥 Stash 原生优势，兼容 App Store 3.4+ 正式版）:
#   1. mode: rule + tcp-concurrent: true —— 多 IP 并发 TCP 握手择快，提升 CDN 与弱网首包。
#   2. 全二进制 format: mrs 规则集 —— 0 个 classical 大文本清单，毫秒级加载、低内存。
#   3. 20 策略组（完整 6 地区池 + 稳定切换 + 手动节点）—— 7 个 url-test 统一 Google HTTPS 探针、
#      900s、tolerance 200、lazy: true（Stash 同节点跨组共享测速结果，兼顾地区自选与低耗电）。
#   4. 全量开屏与信息流去广告 —— 网络层(0 MITM + REJECT-DROP) + Stash 原生零 JS url-rewrite
#      + 内嵌 payload JS(0 外部脚本下载，根治 Scripts Not Downloaded)；MITM 严格零银行/支付/政务域。
#   5. YouTube 增强 —— Maasea 锁定 commit 65075cd（原生 binary-mode + 第三方 Worker，需真机观察；
#      若播放卡顿可注释下方 YouTube 脚本 3 条 hook 后重载覆写，主分流与开屏去广告不受影响）。

mode: rule
tcp-concurrent: true

proxy-groups: #!replace
  # ---- 业务策略组（12 组）----
  - name: 默认代理
    type: select
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Global.png
    proxies: [美国节点, 稳定切换, 日本节点, 新加坡节点, 台湾节点, 香港节点, 其他节点, 手动节点, REJECT]
  - name: YouTube
    type: select
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/YouTube.png
    proxies: [美国节点, 日本节点, 新加坡节点, 台湾节点, 香港节点, 稳定切换, 手动节点, REJECT]
  - name: AI
    type: select
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Bot.png
    proxies: [美国节点, 日本节点, 新加坡节点, 台湾节点, 默认代理, 手动节点]
    # 严格不含香港节点与 DIRECT；不直接铺开裸节点，单节点固定走「手动节点」。
  - name: Google
    type: select
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Google.png
    proxies: [美国节点, 日本节点, 新加坡节点, 台湾节点, 香港节点, 默认代理, 手动节点]
    # 共享 Google 登录 / FCM 与 AI 同默认美国池，且支持按需切地区。
  - name: 社交媒体
    type: select
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Twitter.png
    proxies: [美国节点, 日本节点, 新加坡节点, 台湾节点, 香港节点, 默认代理, 手动节点]
  - name: 国际媒体
    type: select
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/ForeignMedia.png
    proxies: [美国节点, 日本节点, 新加坡节点, 台湾节点, 香港节点, 默认代理, 手动节点]
  - name: Spotify
    type: select
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Spotify.png
    proxies: [新加坡节点, 美国节点, 日本节点, 香港节点, 手动节点, REJECT]
  - name: Telegram
    type: select
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Telegram.png
    proxies: [新加坡节点, 香港节点, 美国节点, 日本节点, 默认代理, 手动节点]
  - name: Apple
    type: select
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Apple.png
    proxies: [DIRECT, 默认代理, 美国节点, 香港节点]
  - name: Microsoft
    type: select
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Microsoft.png
    proxies: [DIRECT, 默认代理, 美国节点, 香港节点]
  - name: 广告过滤
    type: select
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Advertising.png
    proxies: [REJECT, DIRECT]
    # DIRECT 仅用于临时排查网络层误杀；不会关闭下方 url-rewrite 与 HTTP 脚本。
  - name: 兜底流量
    type: select
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Final.png
    proxies: [默认代理, DIRECT]

  # ---- 节点池（8 组：include-all 同时纳入机场订阅与本地自定义节点）----
  # 全部 url-test 共用 Google HTTPS 探针、900s、tolerance 200、lazy: true；并排除机场信息条。
  - name: 稳定切换
    type: url-test
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Available.png
    include-all: true
    exclude-filter: '(?i)剩余|到期|过期|官网|流量|套餐|网站|售后|客服|更新|Expire|Traffic|Reset|GB|MB'
    url: https://www.gstatic.com/generate_204
    interval: 900
    tolerance: 200
    lazy: true
  - name: 手动节点
    type: select
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Static.png
    include-all: true
    exclude-filter: '(?i)剩余|到期|过期|官网|流量|套餐|网站|售后|客服|更新|Expire|Traffic|Reset|GB|MB'
  - name: 美国节点
    type: url-test
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/United_States.png
    include-all: true
    exclude-filter: '(?i)剩余|到期|过期|官网|流量|套餐|网站|售后|客服|更新|Expire|Traffic|Reset|GB|MB'
    filter: '(?i)(?:^|[^a-z])(?:us|usa|united[ _-]?states|america|los[ _-]?angeles|silicon[ _-]?valley)(?:$|[^a-z])|美国|美國|美西|美东|美東|美中|沪美|洛杉矶|洛杉磯|圣何塞|西雅图|芝加哥|纽约|凤凰城|硅谷|🇺🇸'
    url: https://www.gstatic.com/generate_204
    interval: 900
    tolerance: 200
    lazy: true
  - name: 日本节点
    type: url-test
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Japan.png
    include-all: true
    exclude-filter: '(?i)剩余|到期|过期|官网|流量|套餐|网站|售后|客服|更新|Expire|Traffic|Reset|GB|MB'
    filter: '(?i)(?:^|[^a-z])(?:jp|jpn|japan|tokyo|osaka)(?:$|[^a-z])|日本|东京|東京|大阪|京日|苏日|沪日|上日|川日|深日|广日|🇯🇵'
    url: https://www.gstatic.com/generate_204
    interval: 900
    tolerance: 200
    lazy: true
  - name: 新加坡节点
    type: url-test
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Singapore.png
    include-all: true
    exclude-filter: '(?i)剩余|到期|过期|官网|流量|套餐|网站|售后|客服|更新|Expire|Traffic|Reset|GB|MB'
    filter: '(?i)(?:^|[^a-z])(?:sg|sgp|singapore)(?:$|[^a-z])|新加坡|狮城|獅城|沪新|京新|深新|杭新|广新|🇸🇬'
    url: https://www.gstatic.com/generate_204
    interval: 900
    tolerance: 200
    lazy: true
  - name: 台湾节点
    type: url-test
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Taiwan.png
    include-all: true
    exclude-filter: '(?i)剩余|到期|过期|官网|流量|套餐|网站|售后|客服|更新|Expire|Traffic|Reset|GB|MB'
    filter: '(?i)(?:^|[^a-z])(?:tw|twn|taiwan|taipei)(?:$|[^a-z])|台湾|台灣|台北|台中|新北|彰化|🇹🇼'
    url: https://www.gstatic.com/generate_204
    interval: 900
    tolerance: 200
    lazy: true
  - name: 香港节点
    type: url-test
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Hong_Kong.png
    include-all: true
    exclude-filter: '(?i)剩余|到期|过期|官网|流量|套餐|网站|售后|客服|更新|Expire|Traffic|Reset|GB|MB'
    filter: '(?i)(?:^|[^a-z])(?:hk|hkg|hong[ _-]?kong)(?:$|[^a-z])|香港|深港|沪港|京港|🇭🇰'
    url: https://www.gstatic.com/generate_204
    interval: 900
    tolerance: 200
    lazy: true
  - name: 其他节点
    type: url-test
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Global.png
    include-all: true
    exclude-filter: '(?i)剩余|到期|过期|官网|流量|套餐|网站|售后|客服|更新|Expire|Traffic|Reset|GB|MB|🇺🇸|🇭🇰|🇹🇼|🇯🇵|🇸🇬|美国|美國|美西|美东|美東|美中|沪美|洛杉矶|洛杉磯|圣何塞|西雅图|芝加哥|纽约|凤凰城|硅谷|香港|深港|沪港|京港|台湾|台灣|台北|台中|新北|彰化|日本|东京|東京|大阪|京日|苏日|沪日|上日|川日|深日|广日|新加坡|狮城|獅城|沪新|京新|深新|杭新|广新|(?:^|[^a-z])(?:us|usa|united[ _-]?states|america|los[ _-]?angeles|silicon[ _-]?valley|hk|hkg|hong[ _-]?kong|tw|twn|taiwan|taipei|jp|jpn|japan|tokyo|osaka|sg|sgp|singapore)(?:$|[^a-z])'
    url: https://www.gstatic.com/generate_204
    interval: 900
    tolerance: 200
    lazy: true

rule-providers: #!replace
  # 全部采用 MRS 二进制索引格式（Stash 3.1+ 支持），体积小、加载快、低内存。
  Ads:
    behavior: domain
    format: mrs
    url: https://raw.githubusercontent.com/217heidai/adblockfilters/main/rules/adblockmihomo.mrs
    path: ./rules/stash-pro-ads.mrs
    interval: 86400
  YouTube:
    behavior: domain
    format: mrs
    url: https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/youtube.mrs
    path: ./rules/stash-pro-youtube.mrs
    interval: 86400
  AI:
    behavior: domain
    format: mrs
    url: https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/category-ai-!cn.mrs
    path: ./rules/stash-pro-ai.mrs
    interval: 86400
  Google:
    behavior: domain
    format: mrs
    url: https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/google.mrs
    path: ./rules/stash-pro-google.mrs
    interval: 86400
  Telegram:
    behavior: domain
    format: mrs
    url: https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/telegram.mrs
    path: ./rules/stash-pro-telegram.mrs
    interval: 86400
  TelegramIP:
    behavior: ipcidr
    format: mrs
    url: https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geoip/telegram.mrs
    path: ./rules/stash-pro-telegram-ip.mrs
    interval: 86400
  Twitter:
    behavior: domain
    format: mrs
    url: https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/twitter.mrs
    path: ./rules/stash-pro-twitter.mrs
