http:
  mitm:
    - 'api.weibo.cn'
    - 'mapi.weibo.cn'
    - 'api.weibo.com'
    - 'mapi.weibo.com'
    - 'sdkapp.uve.weibo.com'
    - 'wbapp.uve.weibo.com'
    - 'sdkapp.mob.uve.weibo.com'
    - 'wbapp.mob.uve.weibo.com'
    - 'bootpreload.uve.weibo.com'
    - 'preload-impression.uve.weibo.com'
    - 'kadmimage.biz.weibo.com'
    - 'adstrategy.biz.weibo.com'
    - 'new.vip.weibo.cn'
    - 'app.bilibili.com'
    - 'app.biliapi.net'
    - 'mp.weixin.qq.com'
    - 'api.zhihu.com'
    - 'm5.amap.com'
    - 'restapi.amap.com'
    - 'mps.amap.com'
    - 'amap-aos-info-nogw.amap.com'
    - '*.googlevideo.com'
    - 'youtubei.googleapis.com'
    - 'youtubei-att.googleapis.com'
    - 'spclient.wg.spotify.com'
    - '*-spclient.spotify.com'
  url-rewrite:
    - '^https?://(www\.)?g\.cn https://www.google.com 302'
    - '^https?://(www\.)?google\.cn https://www.google.com 302'
    - '^https://(\w+-spclient|spclient\.wg)\.spotify\.com(:443)?/pendragon/ - reject-dict'
    - '^https://(\w+-spclient|spclient\.wg)\.spotify\.com(:443)?/artistview/v1/artist/(.*)&platform=iphone https://spclient.wg.spotify.com/artistview/v1/artist/$3&platform=ipad transparent'
    - '^https?:\/\/amap-aos-info-nogw\.amap\.com\/ws\/aos\/alimama\/splash_screen - reject-200'
    - '^https?:\/\/bootpreload\.uve\.weibo\.com\/ - reject-200'
    - '^https?:\/\/kadmimage\.biz\.weibo\.com\/ - reject-200'
    - '^https?:\/\/adstrategy\.biz\.weibo\.com\/ - reject-200'
    - '^https?:\/\/preload\-impression\.uve\.weibo\.com\/ - reject-200'
  script:
    # 微博主体去广告
    - name: 'weibo_main'
      match: '^https?://m?api\.weibo\.c(n|om)/2/(cardlist|searchall|page|messageflow|statuses/(unread_)?friends(/|_)timeline|groups/timeline|statuses/(container_timeline|unread_hot_timeline|extend|video_mixtimeline|repost_timeline|show)|profile/(me|info|container_timeline)|video/(community_tab|remind_info|tiny_stream_video_list)|checkin/show|\!/live/media_homelist|comments/(build_comments|hotflow)|container/get_item|search/(finder|container_timeline|container_discover)|photo/info|\!/client/active_box)'
      type: response
      require-body: true
      max-size: 2097152
      timeout: 10
    # 微博开屏去广告
    - name: 'weibo_launch'
      match: '^https?://(sdk|wb)app\.(mob\.)?uve\.weibo\.com/(interface/sdk/sdkad\.php|wbapplua/wbpullad\.lua)'
      type: response
      require-body: true
      max-size: 2097152
      timeout: 10
    # 微博开屏备用
    - name: 'weibo_launch'
      match: '^https?://m?api\.weibo\.c(n|om)/2/!/client/(wbpullad|sdkad|splash|launch|openscreen)'
      type: response
      require-body: true
      max-size: 2097152
      timeout: 10
    # 微博Tab自定义
    - name: 'weibo_main'
      match: '^https://api\.weibo\.cn/2/!/client/light_skin'
      type: response
      require-body: true
      max-size: 2097152
      timeout: 10
    # 微博皮肤解锁
    - name: 'weibo_main'
      match: '^https://new\.vip\.weibo\.cn/littleskin/preview'
      type: response
      require-body: true
      max-size: 2097152
      timeout: 10
    # B站首页
    - name: 'bilibili'
      match: '^https://(app\.biliapi\.net|app\.bilibili\.com)/x/v2/feed/index'
      type: response
      require-body: true
      max-size: 2097152
      timeout: 10
    # 微信公众号去广告
    - name: 'Wechat'
      match: '^https?://mp\.weixin\.qq\.com/mp/getappmsgad'
      type: response
      require-body: true
      max-size: 2097152
      timeout: 10
    # 知乎个人页
    - name: 'zheye.min'
      match: '^https?://api\.zhihu\.com/people/'
      type: response
      require-body: true
      max-size: 2097152
      timeout: 10
    # 知乎推荐流
    - name: 'zheye.min'
      match: '^https://api\.zhihu\.com/topstory/recommend'
      type: response
      require-body: true
      max-size: 2097152
      timeout: 10
    # 知乎评论
    - name: 'zheye.min'
      match: '^https?://api\.zhihu\.com/(comment_v5/)?(answers|comments?|articles|pins)/\d+/(root_|child_)?comments?'
      type: response
      require-body: true
      max-size: 2097152
      timeout: 10
    # 知乎问答
    - name: 'zheye.min'
      match: '^https?://api\.zhihu\.com/(v4/)?questions/\d+'
      type: response
      require-body: true
      max-size: 2097152
      timeout: 10
    # 知乎热榜
    - name: 'zheye.min'
      match: '^https?://api\.zhihu\.com/topstory/hot-lists?(\?|/)'
      type: response
      require-body: true
      max-size: 2097152
      timeout: 10
    # 高德开屏
    - name: 'amap'
      match: '^https?://.*\.amap\.com/ws/valueadded/alimama/splash_screen'
      type: response
      require-body: true
      max-size: 2097152
      timeout: 10
    # 高德弹窗
    - name: 'amap'
      match: '^https?://.*\.amap\.com/ws/msgbox/pull'
      type: response
      require-body: true
      max-size: 2097152
      timeout: 10
    # 高德横幅
    - name: 'amap'
      match: '^https?://.*\.amap\.com/ws/faas/amap-navigation/main-page'
      type: response
      require-body: true
      max-size: 2097152
      timeout: 10
    # YouTube.response
    - name: 'youtube.response'
      match: '^https://youtubei(?:-att)?\.googleapis\.com/(youtubei/v1/(browse|next|player|search|reel/reel_watch_sequence|guide|account/get_setting|get_watch|log_event|config))(\?(.*))?$'
      type: response
      require-body: true
      binary-mode: true
      max-size: 5242880
      timeout: 10
      argument: '{"captionLang":"off","blockUpload":true,"blockImmersive":true,"blockShorts":false,"debug":false}'
    # YouTube.request.init
    - name: 'youtube.request'
      match: '^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.*'
      type: request
      require-body: true
      binary-mode: true
      max-size: 5242880
      timeout: 10
      argument: '{"captionLang":"off"}'
    # YouTube.request.log_event
    - name: 'youtube.request'
      match: '^https://youtubei(?:-att)?\.googleapis\.com/youtubei/v1/log_event'
      type: request
      require-body: true
      binary-mode: true
      max-size: 5242880
      timeout: 10
    # Spotify去广告
    - name: 'Spotify.Crack.Dev'
      match: '^https://(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?/(?:bootstrap|user-customization-service)'
      type: response
      require-body: true
      binary-mode: true
      max-size: 5242880
      timeout: 10
      argument: '[true,true]'

script-providers:
  'weibo_main':
    url: https://raw.githubusercontent.com/zmqcherish/proxy-script/main/weibo_main.js
    interval: 86400
  'weibo_launch':
    url: https://raw.githubusercontent.com/zmqcherish/proxy-script/main/weibo_launch.js
    interval: 86400
  'bilibili':
    url: https://raw.githubusercontent.com/zmqcherish/proxy-script/main/bilibili/bilibili.js
    interval: 86400
  'Wechat':
    url: https://raw.githubusercontent.com/NobyDa/Script/master/QuantumultX/File/Wechat.js
    interval: 86400
  'zheye.min':
    url: https://gist.githubusercontent.com/blackmatrix7/f5f780d0f56b319b6ad9848fd080bb18/raw/zheye.min.js
    interval: 86400
  'amap':
    url: https://raw.githubusercontent.com/ddgksf2013/Scripts/master/amap.js
    interval: 86400
  'youtube.response':
    url: https://raw.githubusercontent.com/Maasea/sgmodule/65075cdb388fc5e3094afd7e7314c67b243f3525/Script/Youtube/youtube.response.js
    interval: 86400
  'youtube.request':
    url: https://raw.githubusercontent.com/Maasea/sgmodule/65075cdb388fc5e3094afd7e7314c67b243f3525/Script/Youtube/youtube.request.js
    interval: 86400
  'Spotify.Crack.Dev':
    url: https://raw.githubusercontent.com/001ProMax/Surge/refs/heads/main/Script/Spotify.Crack.Dev.js
    interval: 86400
