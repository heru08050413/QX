name: "Stash SR 移植版 V26.00"
desc: "由 shadowrocket_V26.00.lsr 自动转换(scripts/sr2stash.py)。策略组/分流/去广告脚本/MITM 与小火箭一致; 所有测速组 lazy: 组闲置时不测速, YouTube 测速只在看 YouTube 时进行。叠加在能显示节点的机场或主配置上使用; 需开 MITM 并信任自己的 CA。YouTube 脚本含第三方 Worker 依赖, 未在 Stash 真机验证。"
# 自动生成, 请勿手改: 改 shadowrocket_V26.00.lsr 后在 proxy-configs/ 下运行 python3 scripts/sr2stash.py。
# 未移植(Stash 无对应或无法核实): [Host] 按域名 DNS(fake-ip 下已等效)、内置 Tailscale、
#   bypass-tun(含 APNs 绕过)、MITM 排除项(Stash 只解密列出的主机)。
# 扩展去广告层(补小火箭只能在 App 内手动加的 blockAds 模块): 合并 Stash_AppAdBlock 与 Stash_Script,
#   去掉与小火箭已移植脚本重叠的微博/知乎脚本。启用本覆写后不要再开那两份旧覆写。
# 已丢弃的 Tailscale 规则: DOMAIN-SUFFIX,ts.net,TAILSCALE | IP-CIDR,100.64.0.0/10,TAILSCALE,no-resolve

proxy-groups: #!replace
  - name: 'Proxy'
    type: select
    icon: 'https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Proxy.png'
    proxies: ['美国节点', 'AutoSelect', '香港节点', '台湾节点', '日本节点', '新加坡节点', 'DIRECT']
  - name: 'AI'
    type: select
    icon: 'https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/ChatGPT.png'
    proxies: ['美国节点', '新加坡节点', '日本节点', 'AutoSelect']
  - name: 'Gemini'
    type: select
    icon: 'https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/Gemini_01.png'
    proxies: ['谷歌服务']
  - name: 'Meta'
    type: select
    icon: 'https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Facebook.png'
    proxies: ['美国节点', '香港节点', '台湾节点', '日本节点', '新加坡节点', 'AutoSelect']
  - name: 'YouTube'
    type: select
    icon: 'https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/YouTube.png'
    proxies: ['美国节点', '香港节点', '台湾节点', '日本节点', '新加坡节点', 'AutoSelect']
  - name: 'Netflix'
    type: select
    icon: 'https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Netflix.png'
    proxies: ['美国节点', '香港节点', '日本节点', '新加坡节点']
  - name: 'Spotify'
    type: select
    icon: 'https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Spotify.png'
    proxies: ['新加坡节点', '香港节点', '日本节点', '美国节点']
  - name: 'TikTok'
    type: select
    icon: 'https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/TikTok.png'
    proxies: ['美国节点', '日本节点', '台湾节点', '新加坡节点']
  - name: 'Telegram'
    type: select
    icon: 'https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Telegram.png'
    proxies: ['美国节点', '新加坡节点', '香港节点', '日本节点', 'AutoSelect']
  - name: 'Instagram'
    type: select
    icon: 'https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Instagram.png'
    proxies: ['美国节点', '日本节点', '新加坡节点', 'AutoSelect']
  - name: 'Twitter'
    type: select
    icon: 'https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Twitter.png'
    proxies: ['美国节点', '日本节点', '新加坡节点', 'AutoSelect']
  - name: '苹果服务'
    type: select
    icon: 'https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Apple.png'
    proxies: ['DIRECT', '美国节点', '香港节点']
  - name: '谷歌服务'
    type: select
    icon: 'https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Google_Search.png'
    proxies: ['美国节点', 'AutoSelect', '香港节点', '台湾节点', '日本节点', '新加坡节点']
  - name: '微软服务'
    type: select
    icon: 'https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Microsoft.png'
    proxies: ['美国节点', 'DIRECT', '香港节点']
  - name: '哔哩哔哩'
    type: select
    icon: 'https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/bilibili.png'
    proxies: ['DIRECT', '香港节点', '台湾节点']
  - name: 'AutoSelect'
    type: url-test
    icon: 'https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Auto.png'
    include-all: true
    url: 'http://cp.cloudflare.com/generate_204'
    interval: 900
    tolerance: 200
    lazy: true
  - name: '香港节点'
    type: url-test
    icon: 'https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Hong_Kong.png'
    include-all: true
    filter: '(?i)🇭🇰|HK|HongKong|Hong Kong|hong kong|香港|深港|沪港|京港|HKG'
    url: 'https://www.gstatic.com/generate_204'
    interval: 900
    tolerance: 200
    lazy: true
  - name: '台湾节点'
    type: url-test
    icon: 'https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Taiwan.png'
    include-all: true
    filter: '(?i)🇹🇼|TW|TWN|Taiwan|Taipei|taiwan|台湾|台灣|台北|台中|新北|彰化'
    url: 'https://www.gstatic.com/generate_204'
    interval: 900
    tolerance: 200
    lazy: true
  - name: '日本节点'
    type: url-test
    icon: 'https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Japan.png'
    include-all: true
    filter: '(?i)🇯🇵|JP|Japan|japan|Tokyo|tokyo|Osaka|日本|东京|大阪|京日|苏日|沪日|上日|川日|深日|广日'
    url: 'https://www.gstatic.com/generate_204'
    interval: 900
    tolerance: 200
    lazy: true
  - name: '新加坡节点'
    type: url-test
    icon: 'https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Singapore.png'
    include-all: true
    filter: '(?i)🇸🇬|SG|SGP|Singapore|singapore|新加坡|狮城|沪新|京新|深新|杭新|广新'
    url: 'https://www.gstatic.com/generate_204'
    interval: 900
    tolerance: 200
    lazy: true
  - name: '美国节点'
    type: url-test
    icon: 'https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/United_States.png'
    include-all: true
    filter: '(?i)🇺🇸|(?:^|[^A-Za-z])(?:US|USA)(?:$|[^A-Za-z])|America|america|United States|美国|凤凰城|洛杉矶|西雅图|芝加哥|纽约|沪美|LosAngeles|SiliconValley'
    url: 'https://www.gstatic.com/generate_204'
    interval: 900
    tolerance: 200
    lazy: true
  - name: 'Final'
    type: select
    icon: 'https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Final.png'
    proxies: ['DIRECT', 'Proxy']

